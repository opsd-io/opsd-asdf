#!/bin/sh
set -eu

INSTALL_TYPE="${ASDF_INSTALL_TYPE:-${1:-version}}"
VERSION="${ASDF_INSTALL_VERSION:-${2:-}}"
DOWNLOAD_PATH="${ASDF_DOWNLOAD_PATH:-${3:-}}"

[ -n "${VERSION}" ] || { echo "Missing version for asdf download" >&2; exit 1; }
[ -n "${DOWNLOAD_PATH}" ] || { echo "Missing download path for asdf download" >&2; exit 1; }

if [ "${INSTALL_TYPE}" != "version" ]; then
  echo "Unsupported install type: ${INSTALL_TYPE}" >&2
  exit 1
fi

OS_NAME="${OPSD_RELEASE_OS:-$(uname -s | tr '[:upper:]' '[:lower:]')}"
ARCH_NAME="${OPSD_RELEASE_ARCH:-$(uname -m)}"

case "${ARCH_NAME}" in
  x86_64) ARCH_NAME="amd64" ;;
  aarch64|arm64) ARCH_NAME="arm64" ;;
esac

BASE_URL="${OPSD_RELEASE_BASE_URL:-https://github.com/opsd-io/opsd-cli/releases/download/v${VERSION}}"
ARCHIVE_NAME="opsd_${VERSION}_${OS_NAME}_${ARCH_NAME}.tar.gz"
ARCHIVE_URL="${BASE_URL}/${ARCHIVE_NAME}"
CHECKSUMS_URL="${BASE_URL}/checksums.txt"

mkdir -p "${DOWNLOAD_PATH}"
curl -fsSL "${ARCHIVE_URL}" -o "${DOWNLOAD_PATH}/${ARCHIVE_NAME}"

checksum_for() {
  file="${1}"

  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "${file}" | awk '{print $1}'
    return
  fi

  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "${file}" | awk '{print $1}'
    return
  fi

  if command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 -r "${file}" | awk '{print $1}'
    return
  fi

  echo "No SHA-256 tool found. Install sha256sum, shasum, or openssl." >&2
  exit 1
}

EXPECTED_CHECKSUM="$(curl -fsSL "${CHECKSUMS_URL}" | awk -v archive="${ARCHIVE_NAME}" '$2 == archive {print $1; exit}')"
[ -n "${EXPECTED_CHECKSUM}" ] || {
  echo "Checksum for ${ARCHIVE_NAME} not found in ${CHECKSUMS_URL}" >&2
  exit 1
}

ACTUAL_CHECKSUM="$(checksum_for "${DOWNLOAD_PATH}/${ARCHIVE_NAME}")"
[ "${ACTUAL_CHECKSUM}" = "${EXPECTED_CHECKSUM}" ] || {
  echo "Checksum verification failed for ${ARCHIVE_NAME}" >&2
  exit 1
}

tar -xzf "${DOWNLOAD_PATH}/${ARCHIVE_NAME}" -C "${DOWNLOAD_PATH}"
rm -f "${DOWNLOAD_PATH}/${ARCHIVE_NAME}"
